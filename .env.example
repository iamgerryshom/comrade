# Data source: "mock" (in-memory demo, default) or "firebase" (Phase 9)
VITE_DATA_SOURCE=mock
# Show the floating demo panel, Mock SMS Inbox and demo accounts
VITE_DEMO_MODE=true
# Seconds to wait for a device ACK before falling back to SMS
VITE_ACK_TIMEOUT_SECONDS=60

# Firebase web config (leave empty until Phase 9)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# NOTE: Africa's Talking API keys are NEVER VITE_ variables.
# They live in Cloud Functions secrets (firebase functions:secrets:set AT_API_KEY).
